{
  "woufguide-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/safety-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "woufguide-quality-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/quality-gate.mjs",
        "timeout": 20
      }
    ]
  }
}
